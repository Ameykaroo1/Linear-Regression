import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import OneHotEncoder
from sklearn.preprocessing import StandardScaler


df = pd.read_csv("Salary Data.csv")
df.head()


df.info()


df.isnull().sum()


df.describe()


df['Age'] = df['Age'].fillna(df['Age'].mean())
df = df.fillna(df.mean(numeric_only=True))
df['Gender'] = df['Gender'].fillna(df['Gender'].mode()[0])
df['Education Level'] = df['Education Level'].fillna(df['Education Level'].mode()[0])
df['Job Title'] = df['Job Title'].fillna(df['Job Title'].mode()[0])


df = pd.get_dummies(df, columns=["Education Level"],drop_first=True,dtype=int)
df = pd.get_dummies(df, columns=["Job Title"],drop_first=True,dtype=int)
df = pd.get_dummies(df, columns=['Gender'],drop_first=True,dtype=int)


df.isnull().sum()



df.head()


X=df.drop(columns='Salary')
y=df['Salary']


df.head()


X_train,X_test,y_train,y_test = train_test_split(
    X,y,test_size=0.3,random_state=42)


X_train.head()


X_test.head()


scaler = StandardScaler()
X_train_scaled =  scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)


model = LinearRegression()
model.fit(X_train,y_train)


y_pred = model.predict(X_test)


y_pred


y_test


from sklearn.metrics import r2_score


r2_test =r2_score(y_test,y_pred)
print(r2_test)
n=X_test.shape[0]
p=X_test.shape[1]

adjusted_r2 = 1-((1-r2)*(n-1)/(n-p-1))
print(adjusted_r2)



print(X_train.shape)
print(X_test.shape)



#underfit & overfit
y_train_pred = model.predict(X_train)
train_r2 = r2_score(y_train, y_train_pred)
r2_test =r2_score(y_test,y_pred)
print(train_r2)
print(r2_test)


#Lasso Regression
from sklearn.linear_model import Lasso
from sklearn.metrics import mean_squared_error


lasso_model = Lasso(alpha=0.5)
lasso_model.fit(X_train,y_train)
y_preds = lasso_model.predict(X_test)


mse = mean_squared_error(y_test,y_preds)
print("MSE:", mse)


from sklearn.linear_model import LassoCV
a=[0.001,0.1,1,2,5,10,20,30,40,50,100]
lasso_cv_model = LassoCV(
    alphas= a,
    cv=5,
    max_iter=10000,
    random_state=42
)

lasso_cv_model.fit(X_train,y_train)
print(lasso_cv_model.alpha_)
y_pred = lasso_cv_model.predict(X_test)
mse = mean_squared_error(y_test,y_pred)
r2 = r2_score(y_test,y_pred)
print(mse)
print(r2)



