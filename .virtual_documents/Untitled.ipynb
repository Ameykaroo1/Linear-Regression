import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression


df = pd.read_csv("Salary Data.csv")
df.head()


df.info()


df.isnull().sum()


df.describe()


df['Age'] = df['Age'].fillna(df['Age'].mean())
df = df.fillna(df.mean(numeric_only=True))
df['Gender'] = df['Gender'].fillna(df['Gender'].mode()[0])
df['Education Level'] = df['Education Level'].fillna(df['Education Level'].mode()[0])
df['Job Title'] = df['Job Title'].fillna(df['Job Title'].mode()[0])


df.isnull().sum()


X=df.drop(columns=['Education Level','Salary'])
y=df['Salary']
X['Gender'] = X['Gender'].map({'Male':1,'Female':0})
X=pd.get_dummies(X,columns=['Job Title'],dtype=int)


X.head()


X_train,X_test,y_train,y_test = train_test_split(
    X,y,test_size=0.3,random_state=42)


X_train.head()


X_test.head()


model = LinearRegression()
model.fit(X_train,y_train)


y_pred = model.predict(X_test)


y_pred


y_test


from sklearn.metrics import r2_score


r2 =r2_score(y_test,y_pred)
print(r2)
n=X_test.shape[0]
p=X_test.shape[1]

adjusted_r2 = 1-((1-r2)*(n-1)/(n-p-1))
print(adjusted_r2)



print(X_train.shape)
print(X_test.shape)



print(df['Job Title'].nunique())



